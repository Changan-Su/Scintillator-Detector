# Geometry macro: crystal array and gap (run before /run/initialize)
# Example: /control/execute geometry.mac
#
# Crystal array (nx, ny, nz)
/detector/arrayNx 11
/detector/arrayNy 3
/detector/arrayNz 3
#
# Crystal gap (fill between crystals), in mm
/detector/crystalGap 0.1 mm
#
# Single crystal size (x/z), in mm (optional; default 3 mm)
/detector/crystalSize 3 mm
#
# Single crystal size in y, in mm (optional; default same as crystalSize)
# /detector/crystalSizeY 3 mm
#
# Update geometry (rebuild with current parameters)
# Note: Only needed if changing parameters AFTER /run/initialize
# /detector/update
